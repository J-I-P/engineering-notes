---
import type { CollectionEntry } from 'astro:content';
import type { TopicMetadata } from '../data/topics';
import { localizeTopic, t, type Locale } from '../i18n';
import { explicitRelations, labelsFor, nodeHref, TOPICS, topicHref } from '../lib/knowledge';
import { localizedHref } from '../lib/urls';

interface Props {
  entries: CollectionEntry<'knowledge'>[];
  topic?: TopicMetadata;
  locale?: Locale;
}

const { entries: allEntries, topic, locale = 'en' } = Astro.props;
const messages = t(locale);
const labels = labelsFor(locale);
const usedTopics = new Set(allEntries.flatMap((entry) => entry.data.topics));
const localizedTopics = TOPICS.filter((item) => usedTopics.has(item.slug)).map((item) => localizeTopic(item, locale));
const entries = topic
  ? allEntries.filter((entry) => entry.data.topics.includes(topic.slug))
  : allEntries;
const visibleIds = new Set(entries.map((entry) => entry.data.nodeId));
const edges = entries.flatMap((entry) =>
  explicitRelations(entry)
    .filter((relation) => visibleIds.has(relation.target))
    .map((relation) => ({ source: entry.data.nodeId, ...relation })),
);
const columns = ['case', 'research', 'experiment', 'learning', 'takeaway', 'project', 'question'] as const;
---

<main class="container explore">
  <header>
    <div class="eyebrow">{messages.explorePage.eyebrow}</div>
    <h1>{topic ? localizeTopic(topic, locale).title : messages.explorePage.heading}</h1>
    <p>{topic ? localizeTopic(topic, locale).description : messages.explorePage.intro}</p>
  </header>

  <nav class="topic-filters" aria-label={messages.explorePage.filterLabel}>
    <a href={localizedHref('/explore/', locale)} class:list={{ active: !topic }}>{messages.explorePage.allTopics}</a>
    {localizedTopics.map((item) => <a href={topicHref(item.slug, locale)} class:list={{ active: topic?.slug === item.slug }}>{item.title}</a>)}
  </nav>

  <div class="graph card">
    <div class="graph__legend">{columns.map((type) => <span class={`pill pill--${type}`}><span class="pill-dot"></span>{labels.type[type]}</span>)}</div>
    <div class="lanes">
      {columns.map((type) => {
        const nodes = entries.filter((entry) => entry.data.type === type);
        if (!nodes.length) return null;
        return <section class="lane"><div class="lane__title">{labels.type[type]}</div>{nodes.map((entry) => <a href={nodeHref(entry.data.nodeId, locale)}><strong>{entry.data.title}</strong><small>{edges.filter((edge) => edge.source === entry.data.nodeId || edge.target === entry.data.nodeId).length} {messages.explorePage.connections}</small></a>)}</section>;
      })}
    </div>
  </div>

  <section class="edge-table">
    <div class="eyebrow">{messages.explorePage.edges}</div>
    <h2>{messages.explorePage.relationships}</h2>
    {edges.length > 0 ? edges.map((edge) => <div><code>{edge.source}</code><span>{labels.relation[edge.type]}</span><code>{edge.target}</code></div>) : <p class="muted">{messages.explorePage.empty}</p>}
  </section>
</main>

<style>
  .explore { padding: 68px 0 90px; }
  header { max-width: 720px; margin-bottom: 35px; }
  h1 { font-size: clamp(2.8rem, 5vw, 5rem); letter-spacing: -.06em; margin: 10px 0 15px; }
  header p { color: var(--muted); line-height: 1.65; }
  .topic-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
  .topic-filters a { border: 1px solid var(--line); border-radius: 999px; padding: 7px 11px; color: var(--muted); font-size: .78rem; }
  .topic-filters a:hover, .topic-filters a.active { color: var(--text); border-color: var(--blue); background: rgba(95,140,255,.1); }
  .graph { padding: 18px; overflow-x: auto; }
  .graph__legend { display: flex; gap: 7px; flex-wrap: wrap; padding: 4px 4px 18px; border-bottom: 1px solid var(--line); }
  .lanes { display: grid; grid-template-columns: repeat(7, minmax(175px, 1fr)); gap: 10px; min-width: 1120px; padding-top: 16px; }
  .lane { display: grid; align-content: start; gap: 9px; }
  .lane__title { color: var(--muted); font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; padding: 0 4px 4px; }
  .lane a { border: 1px solid var(--line); border-radius: 13px; background: #091127; padding: 12px; display: grid; gap: 8px; }
  .lane a:hover { border-color: #425985; }
  .lane strong { font-size: .81rem; line-height: 1.3; }
  .lane small { color: var(--muted); }
  .edge-table { margin-top: 48px; }
  .edge-table h2 { margin: 6px 0 15px; }
  .edge-table > div:not(.eyebrow) { display: grid; grid-template-columns: 1fr 170px 1fr; gap: 14px; align-items: center; padding: 11px 0; border-top: 1px solid var(--line); }
  .edge-table span { color: var(--orange); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; text-align: center; }
  .edge-table code { color: #b8c7e8; font-size: .78rem; }
</style>
