---
import type { CollectionEntry } from 'astro:content';
import { t, type Locale } from '../i18n';
import { labelsFor, nodeHref } from '../lib/knowledge';

interface Props {
  path: CollectionEntry<'knowledge'>[];
  currentId: string;
  locale?: Locale;
}
const { path, currentId, locale = 'en' } = Astro.props;
const messages = t(locale);
const labels = labelsFor(locale);
---

<div class="path card">
  <div class="path__heading">
    <div>
      <div class="eyebrow">{messages.article.path}</div>
      <h2>{messages.article.formed}</h2>
    </div>
    <span class="muted">{path.length} {path.length === 1 ? messages.article.node : messages.article.nodes}</span>
  </div>
  <div class="path__nodes">
    {path.map((node, index) => (
      <>
        <a class:list={['path-node', { current: node.data.nodeId === currentId }]} href={nodeHref(node.data.nodeId, locale)}>
          <span class={`pill pill--${node.data.type}`}><span class="pill-dot"></span>{labels.type[node.data.type]}</span>
          <strong>{node.data.title}</strong>
        </a>
        {index < path.length - 1 && <span class="arrow">→</span>}
      </>
    ))}
  </div>
</div>

<style>
  .path { padding: 22px; }
  .path__heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
  .path__heading h2 { font-size: 1.15rem; margin: 5px 0 0; }
  .path__nodes { display: flex; align-items: stretch; gap: 10px; overflow-x: auto; padding-top: 18px; }
  .path-node { min-width: 190px; border: 1px solid var(--line); border-radius: 14px; padding: 13px; background: #0a1126; display: flex; flex-direction: column; gap: 10px; }
  .path-node strong { font-size: .86rem; line-height: 1.35; }
  .path-node.current { border-color: var(--orange); box-shadow: inset 0 0 0 1px rgba(255,107,0,.28), 0 0 28px rgba(255,107,0,.08); }
  .arrow { align-self: center; color: #52658d; }
</style>
