---
import { getCollection } from 'astro:content';
import ExploreView from '../components/ExploreView.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('knowledge', ({ data }) => !data.draft);
---

<BaseLayout title="Explore — J-I-P" description="Explore engineering knowledge by type, topic, and semantic relationship.">
  <ExploreView entries={entries} />
</BaseLayout>
