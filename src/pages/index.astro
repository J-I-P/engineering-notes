---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizeTopic, t, type Locale } from '../i18n';
import { compareByRecency, entriesForLocale, FEATURED_TOPICS, labelsFor, nodeHref, topicHref } from '../lib/knowledge';
import { localizedHref } from '../lib/urls';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const messages = t(locale);
const labels = labelsFor(locale);
const alternateLocale: Locale = locale === 'en' ? 'zh-tw' : 'en';
const entries = entriesForLocale(await getCollection('knowledge', ({ data }) => !data.draft), locale).sort(compareByRecency);

const questions = entries.filter((entry) => entry.data.type === 'question');
const cases = entries.filter((entry) => entry.data.type === 'case');
const recentlyFormed = entries
  .filter((entry) => !['case', 'question', 'project'].includes(entry.data.type))
  .slice(0, 4);

const activeTopics = FEATURED_TOPICS
  .map((topic) => ({
    ...localizeTopic(topic, locale),
    count: entries.filter((entry) => entry.data.topics.includes(topic.slug)).length,
  }))
  .filter((topic) => topic.count > 0);
---

<BaseLayout locale={locale} alternateURL={localizedHref('/', alternateLocale)}>
  <main>
    <section class="hero container">
      <div class="hero__copy">
        <div class="eyebrow">{messages.homePage.eyebrow}</div>
        <h1>{messages.homePage.title1}<br /><span>{messages.homePage.title2}</span></h1>
        <p>{messages.homePage.intro}</p>
        <div class="hero__actions">
          <a class="primary" href={localizedHref('/explore/', locale)}>{messages.homePage.exploreGraph}</a>
          <a class="secondary" href="#knowledge">{messages.homePage.readNodes}</a>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="section-heading">
        <div><div class="eyebrow">{messages.homePage.currently}</div><h2>{messages.homePage.activeAreas}</h2></div>
      </div>
      <div class="branch-grid">
        {activeTopics.map((topic) => (
          <a class="branch card card-hover" href={topicHref(topic.slug, locale)}>
            <strong>{topic.title}</strong>
            <span>{topic.count} {topic.count === 1 ? messages.homePage.node : messages.homePage.nodes}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section container" id="knowledge">
      <div class="section-heading">
        <div><div class="eyebrow">{messages.homePage.recently}</div><h2>{messages.homePage.knowledgeNotPosts}</h2></div>
        <a class="muted" href={localizedHref('/explore/', locale)}>{messages.homePage.viewGraph}</a>
      </div>
      <div class="content-list">
        {recentlyFormed.map((entry) => (
          <a href={nodeHref(entry.data.nodeId, locale)}>
            <span class={`content-type content-type--${entry.data.type}`}>{labels.type[entry.data.type]}</span>
            <strong>{entry.data.title}</strong>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section container cases-section">
      <div class="section-heading"><div><div class="eyebrow">{messages.homePage.origins}</div><h2>{messages.homePage.cases}</h2></div></div>
      <div class="content-list">
        {cases.map((entry) => (
          <a href={nodeHref(entry.data.nodeId, locale)}><strong>{entry.data.title}</strong><span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </section>

    <section class="section container" id="open-questions">
      <div class="section-heading"><div><div class="eyebrow">{messages.homePage.uncertainty}</div><h2>{messages.homePage.questions}</h2></div></div>
      <div class="question-list">
        {questions.map((entry, index) => (
          <a href={nodeHref(entry.data.nodeId, locale)}>
            <span class="number">0{index + 1}</span>
            <div><strong>{entry.data.title}</strong><p>{entry.data.description}</p></div>
            <span>↗</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <style>
    .hero { min-height: 520px; padding-top: 88px; padding-bottom: 70px; display: flex; align-items: center; }
    .hero h1 { margin: 12px 0 20px; font-size: clamp(3.1rem, 6vw, 5.9rem); line-height: .93; letter-spacing: -.072em; }
    .hero h1 span { color: #98a7c5; }
    .hero__copy > p { max-width: 670px; font-size: 1.05rem; color: var(--muted); line-height: 1.7; }
    .hero__actions { display: flex; gap: 10px; margin-top: 28px; flex-wrap: wrap; }
    .primary, .secondary { border-radius: 12px; padding: 11px 15px; font-size: .88rem; font-weight: 750; }
    .primary { background: var(--orange); color: #fff; }
    .secondary { border: 1px solid var(--line); color: #c9d2e5; }
    .branch-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .branch { padding: 20px; display: grid; gap: 10px; }
    .branch strong { font-size: 1rem; }
    .branch span { color: var(--muted); font-size: .8rem; }
    .content-list { border-top: 1px solid var(--line); }
    .content-list a { display: grid; grid-template-columns: 145px 1fr auto; gap: 18px; align-items: center; padding: 20px 8px; border-bottom: 1px solid var(--line); }
    .content-list a:hover strong { color: #a9c0ff; }
    .content-type { color: var(--blue); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .content-type--experiment { color: #b083ff; }
    .content-type--learning { color: var(--green); }
    .content-type--takeaway { color: var(--orange); }
    .question-list { border-top: 1px solid var(--line); }
    .question-list a { display: grid; grid-template-columns: 55px 1fr auto; gap: 18px; align-items: center; padding: 19px 8px; border-bottom: 1px solid var(--line); }
    .question-list a:hover strong { color: #a9c0ff; }
    .question-list .number { color: var(--orange); font-family: monospace; }
    .question-list strong { font-size: 1rem; }
    .question-list p { margin: 5px 0 0; color: var(--muted); font-size: .85rem; }
    @media (max-width: 860px) { .hero { padding-top: 55px; } .branch-grid { grid-template-columns: repeat(2, 1fr); } .content-list a { grid-template-columns: 110px 1fr auto; } }
    @media (max-width: 520px) { .branch-grid { grid-template-columns: 1fr; } .content-list a { grid-template-columns: 1fr auto; } .content-type { grid-column: 1 / -1; } }
  </style>
</BaseLayout>
